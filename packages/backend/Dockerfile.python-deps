FROM node:20-slim

RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    python3 \
    python3-pip \
    libopenblas-dev \
    liblapack-dev \
    && rm -rf /var/lib/apt/lists/*

RUN pip3 install --break-system-packages --upgrade pip

# Pin numpy<2 — torch 2.2.2 and facenet-pytorch require numpy 1.x
RUN pip3 install --break-system-packages "numpy<2"

# Install facenet-pytorch without its torch dependency (avoids pulling GPU torch)
RUN pip3 install --break-system-packages \
    --no-deps facenet-pytorch \
    && pip3 install --break-system-packages \
        tqdm requests

# Install torch CPU — +cpu suffix only exists for amd64, not arm64
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "x86_64" ]; then \
        pip3 install --break-system-packages \
            "torch==2.2.2+cpu" "torchvision==0.17.2+cpu" \
            --index-url https://download.pytorch.org/whl/cpu; \
    else \
        pip3 install --break-system-packages \
            "torch==2.2.2" "torchvision==0.17.2"; \
    fi

# Install dlib (compiles from source — slow on arm64/QEMU but cached here)
RUN pip3 install --break-system-packages dlib

# Install remaining deps — pin Pillow<10.3 for facenet-pytorch compatibility
RUN pip3 install --break-system-packages \
    face_recognition \
    "Pillow>=10.2.0,<10.3.0" \
    pillow-heif \
    mediapipe
